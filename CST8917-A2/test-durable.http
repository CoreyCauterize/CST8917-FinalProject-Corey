### Base URL
@baseUrl = http://localhost:7071/api
@instanceId = <PASTE_INSTANCE_ID_HERE>

### Notes
# 1) Run a scenario start request.
# 2) Copy the returned id into @instanceId.
# 3) Run manager-decision/status for that same id.

### 1) Valid expense under $100 -> Auto-approved
POST {{baseUrl}}/expenses/start
Content-Type: application/json

{
  "employee_name": "Alice Johnson",
  "employee_email": "alice@example.com",
  "amount": 42.50,
  "category": "meals",
  "description": "Team lunch",
  "manager_email": "manager@example.com"
}

### 2) Valid expense >= $100, manager approves -> Approved
# Step 1: Start workflow and copy instanceId from the status URLs in response.
POST {{baseUrl}}/expenses/start
Content-Type: application/json

{
  "employee_name": "Bob Smith",
  "employee_email": "bob@example.com",
  "amount": 350,
  "category": "travel",
  "description": "Flight to conference",
  "manager_email": "manager@example.com",
  "timeout_seconds": 180
}

### Step 2: Submit manager approval (replace instance id)
POST {{baseUrl}}/expenses/{{instanceId}}/manager-decision
Content-Type: application/json

{
  "decision": "approved",
  "comment": "Approved for business travel"
}

### 3) Valid expense >= $100, manager rejects -> Rejected
# Step 1: Start workflow and copy instanceId from the status URLs in response.
POST {{baseUrl}}/expenses/start
Content-Type: application/json

{
  "employee_name": "Carla Gomez",
  "employee_email": "carla@example.com",
  "amount": 125,
  "category": "supplies",
  "description": "Office chair",
  "manager_email": "manager@example.com",
  "timeout_seconds": 180
}

### Step 2: Submit manager rejection (replace instance id)
POST {{baseUrl}}/expenses/{{instanceId}}/manager-decision
Content-Type: application/json

{
  "decision": "rejected",
  "comment": "Budget freeze"
}

### 4) Valid expense >= $100, no manager response -> Escalated
# Start and do NOT send manager decision.
# Use a short timeout for testing convenience.
POST {{baseUrl}}/expenses/start
Content-Type: application/json

{
  "employee_name": "Derek Lee",
  "employee_email": "derek@example.com",
  "amount": 500,
  "category": "equipment",
  "description": "Monitor",
  "manager_email": "manager@example.com",
  "timeout_seconds": 15
}

### 5) Missing required fields -> Validation error
POST {{baseUrl}}/expenses/start
Content-Type: application/json

{
  "employee_name": "Evan Miles",
  "employee_email": "evan@example.com",
  "amount": 60,
  "category": "software",
  "description": "Subscription"
}

### 6) Invalid category -> Validation error
POST {{baseUrl}}/expenses/start
Content-Type: application/json

{
  "employee_name": "Fatima Noor",
  "employee_email": "fatima@example.com",
  "amount": 75,
  "category": "fuel",
  "description": "Taxi receipts",
  "manager_email": "manager@example.com"
}

### Optional: check status (replace instance id)
GET {{baseUrl}}/expenses/{{instanceId}}/status
